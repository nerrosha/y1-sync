{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Y1 Sync",
  "version": "1.0.0",
  "identifier": "io.github.nerrosha.y1sync",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Y1 Sync",
        "width": 1040,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/y1sync",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
